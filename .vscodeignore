# Source is bundled into dist/extension.js by esbuild -- not needed at runtime.
src/**
.vscode/**
.gitignore
eslint.config.js
esbuild.js
tsconfig.json
*.tsbuildinfo

# node_modules IS shipped (intentionally -- see esbuild.js's `packages: 'external'`
# comment): oxigraph, eyereasoner/swipl-wasm, shacl-engine's Comunica-lite tree, and
# @viz-js/viz all load WASM/native assets from paths relative to their own package
# directory, which bundling would break. Only trim obvious dev-only bloat within it.
node_modules/**/*.md
node_modules/**/*.markdown
node_modules/**/CHANGELOG*
node_modules/**/LICENSE*
node_modules/**/*.map
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/.github/**
node_modules/.package-lock.json

package-lock.json
