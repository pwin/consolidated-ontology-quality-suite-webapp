PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oq: <https://semantechs.co.uk/ontology-quality/>

# CNF-003: rdfs:domain violation
#
# Also recognizes gist-style domainIncludes annotations, matched by local
# name (not a hardcoded gist namespace IRI, since gist has published under
# more than one over the years) -- see STR-003.rq for why: gist
# deliberately favors these soft annotation properties over rdfs:domain for
# most shared properties, so a domain check that only understood
# rdfs:domain would never fire on gist-based data at all.
#
# A subject is only flagged if it has SOME asserted type that fails to
# match (or descend from, via rdfs:subClassOf*) every declared domain
# class -- an entirely untyped subject is STR-009's concern ("Untyped
# subject of a triple"), not this check's, and a multi-typed subject where
# at least one type satisfies the domain is not a violation.
#
# A domain or range declared as an `owl:unionOf` is an anonymous class node,
# and `rdfs:subClassOf*` from an asserted type can never reach one -- so every
# use of a union-domained property was reported as a violation, and every
# value of a union-ranged one. `(owl:unionOf/rdf:rest*/rdf:first)*` steps from
# the declared class expression into its union members, zero or more times:
# zero steps leaves a named class alone, one reaches each member, and more
# handle a union nested in a union. Measured on HOLOS over eight cases: five
# were wrong before and all five are right now, with the two genuine
# violations still reported.
#
# Not a corner case -- gist declares 13 anonymous domains and ranges and every
# one is a union, as are all three in the W3C org vocabulary this project's
# fixtures carry (`org:reportsTo`, `org:role`).
CONSTRUCT {
  _:r a sh:ValidationResult ;
    sh:resultSeverity sh:Violation ;
    sh:focusNode ?s ;
    sh:resultPath ?p ;
    sh:sourceConstraintComponent oq:CNF-003 ;
    sh:resultMessage ?msg .
}
WHERE {
  ?s ?p ?o .
  FILTER EXISTS { { ?p rdfs:domain ?anyDomain } UNION { ?p ?dip ?anyDomain . FILTER(STRENDS(STR(?dip), "domainIncludes")) } }
  FILTER EXISTS { ?s a ?anyType }
  FILTER NOT EXISTS {
    ?s a ?matchType .
    { ?p rdfs:domain ?dcTop } UNION { ?p ?dip2 ?dcTop . FILTER(STRENDS(STR(?dip2), "domainIncludes")) }
    ?dcTop (owl:unionOf/rdf:rest*/rdf:first)* ?dc .
    ?matchType rdfs:subClassOf* ?dc .
  }
  BIND(CONCAT("Property ", STR(?p), " is used with subject ", STR(?s),
              ", whose asserted type(s) don't match (or descend from) any of the property's declared domain classes (rdfs:domain or gist-style domainIncludes).") AS ?msg)
}
